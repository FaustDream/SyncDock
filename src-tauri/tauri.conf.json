{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "SyncDock",
    "version": "2.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "all": true
      },
      "path": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "targets": ["nsis"],
      "identifier": "com.syncdock.desktop",
      "shortDescription": "多 Git 仓库一键同步工作台",
      "longDescription": "SyncDock 是一款专为开发者设计的 Git 仓库批量同步工具，支持多仓库管理、智能状态检测、定时同步等功能。",
      "icon": ["icons/icon.ico"],
      "windows": {
        "nsis": {
          "installerIcon": "icons/icon.ico",
          "installMode": "currentUser",
          "languages": ["SimpChinese", "English"],
          "displayLanguageSelector": true
        }
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "同步坞 SyncDock",
        "width": 1480,
        "height": 940,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "decorations": true,
        "fullscreen": false
      }
    ]
  }
}
